## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# dotenv environment variables file
.env

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# ---- iRacingTools: kept on this PC, not in git ----

# Per-PC settings (window positions, controller IDs, reference laps). Each app writes defaults when its file is missing.
IRacingOverlays/overlays.json
IRacingOverlays.Tests/overlays.json
IRacingVoice/voice.json
IRacingCoach/coach.json
IRacingBroadcast/broadcast.json

# Voice and speech models: large, downloaded on first use
IRacingVoice/voices/
IRacingVoice/voice-samples/
*.onnx
ggml-*.bin

# Car brand logos: trademarks from Wikipedia, kept local (the overlay shows a text tag without them)
IRacingOverlays/logos/

# Real iRacing session dumps and telemetry: other drivers' names and IDs
session-info.yaml
*.ibt
*.olap
*.blap

# Personal logs and scratch output
perflogs/
cc-real-log.txt
.vs/

# Built from your own driving, or other drivers' laps: regenerated or downloaded per car and track
IRacingVoice/coach/
IRacingVoice/reference/
IRacingCoach/corners.json
IRacingCoach/coach_notes.md
*.tar.bz2
