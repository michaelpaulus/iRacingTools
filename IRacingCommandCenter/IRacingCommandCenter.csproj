<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- UIAutomationClient: AutoJoin presses the iRacing app's Join button through Windows accessibility.
         Referenced on its own rather than with UseWPF, which would change the implicit usings. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IRacingCommandCenter</RootNamespace>
    <AssemblyName>IRacingCommandCenter</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>iRacing Command Center</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
